          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extraer token" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">try {
  def json = new groovy.json.JsonSlurper().parse(prev.getResponseData())
  def rawToken = json.token
  if (rawToken != null &amp;&amp; rawToken.toString().length() &gt; 10) {
    vars.put(&apos;token&apos;, rawToken.toString())
    log.info(&quot;TOKEN EXTRACTED OK: &quot; + rawToken.toString().substring(0, 20) + &quot;...&quot;)
  } else {
    log.warn(&quot;TOKEN NULL OR TOO SHORT, keeping previous value&quot;)
  }
} catch (Exception e) {
  log.error(&quot;TOKEN EXTRACTION FAILED: &quot; + e.getMessage())
}</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
