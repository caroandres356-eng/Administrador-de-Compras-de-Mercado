{
  "info": {
    "name": "MercaList CRUD",
    "description": "Colección de pruebas de sistema para el CRUD de listas de compras",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Registrar usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Usuario registrado exitosamente', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('token');",
              "    pm.environment.set('token', jsonData.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"postman@test.com\",\n  \"password\": \"123456\",\n  \"name\": \"Postman Tester\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/register",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Crear lista de compras",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista creada exitosamente', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql('Supermercado Semanal');",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.environment.set('listId', jsonData.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Supermercado Semanal\",\n  \"emoji\": \"🛒\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/lists",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "lists"]
        }
      }
    },
    {
      "name": "3. Obtener lista por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista obtenida correctamente', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData.name).to.eql('Supermercado Semanal');",
              "    pm.expect(jsonData).to.have.property('products');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/lists/{{listId}}",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "lists", "{{listId}}"]
        }
      }
    },
    {
      "name": "4. Agregar producto a la lista",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Producto agregado correctamente', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql('Leche');",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.environment.set('productId', jsonData.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Leche\",\n  \"quantity\": 2,\n  \"unit\": \"l\",\n  \"price\": 3.5,\n  \"category\": \"comida\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/lists/{{listId}}/products",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "lists", "{{listId}}", "products"]
        }
      }
    },
    {
      "name": "5. Obtener productos de la lista",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Productos obtenidos correctamente', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;",
              "    pm.expect(jsonData.length).to.be.at.least(1);",
              "    pm.expect(jsonData[0].name).to.eql('Leche');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/lists/{{listId}}/products",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "lists", "{{listId}}", "products"]
        }
      }
    },
    {
      "name": "6. Actualizar lista",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista actualizada correctamente', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql('Mercado Quincenal');",
              "    pm.expect(jsonData.emoji).to.eql('🛍️');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mercado Quincenal\",\n  \"emoji\": \"🛍️\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/lists/{{listId}}",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "lists", "{{listId}}"]
        }
      }
    },
    {
      "name": "7. Eliminar lista",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista eliminada exitosamente', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Lista ya no existe', function () {",
              "    const getRequest = {",
              "        url: 'http://localhost:8080/api/lists/' + pm.environment.get('listId'),",
              "        method: 'GET',",
              "        header: { 'Authorization': 'Bearer ' + pm.environment.get('token') }",
              "    };",
              "    pm.sendRequest(getRequest, function (err, response) {",
              "        pm.expect(response.code).to.eql(500);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/lists/{{listId}}",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "lists", "{{listId}}"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "listId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ]
}
