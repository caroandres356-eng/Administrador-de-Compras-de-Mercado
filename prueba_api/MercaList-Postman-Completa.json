    {
      "name": "=== AUTH ===",
      "item": [
        {
          "name": "A1 - Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = 'test_' + Date.now() + '@mercalist.com';",
                  "pm.environment.set('email', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Tiene token', () => pm.expect(json).to.have.property('token'));",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"123456\", \"name\": \"Test User\"}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/register",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "A2 - Login correcto",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Tiene token', () => pm.expect(json).to.have.property('token'));",
                "pm.environment.set('token', json.token);"
              ]
            }
          }],
          "request": {
